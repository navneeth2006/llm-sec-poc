<group name="llm_security,">
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="kind">attack_result</field>
    <description>LLM security test result logged</description>
  </rule>
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="result">VULNERABLE</field>
    <description>LLM attack succeeded: $(risk) on $(model) (mitigation $(mitigation))</description>
  </rule>
  <rule id="100102" level="5">
    <decoded_as>json</decoded_as>
    <field name="kind">mitigation_block</field>
    <description>Mitigation blocked an attack: $(risk)</description>
  </rule>
</group>
